# syntax=docker/dockerfile:1
FROM python:3.12-slim

# 国内构建默认走阿里云 PyPI 镜像；海外构建可 --build-arg PIP_INDEX_URL=https://pypi.org/simple 覆盖
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

# 安装基础工具
RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 先安装 vendored astock（引擎本体）
COPY vendor/astock ./vendor/astock
RUN pip install --no-cache-dir ./vendor/astock

# 再安装 engine 服务
COPY engine ./engine
RUN pip install --no-cache-dir ./engine

# 暴露服务端口
EXPOSE 8000

# 默认启动命令
CMD ["uvicorn", "engine.main:app", "--host", "0.0.0.0", "--port", "8000"]
