api:
  base_url: http://localhost:8000          # polytact engine 地址
  username: ${ENGINE_USERNAME}             # engine 登录账号
  password: ${ENGINE_PASSWORD}             # engine 登录密码
  timeout: 30
llm:
  # digest 浓缩用的 LLM：默认走百炼 Coding Plan（OpenAI 兼容），与引擎同一份凭据
  base_url: ${BACKEND_URL}
  api_key: ${OPENAI_COMPATIBLE_API_KEY}
  model: qwen3.7-plus
  max_tokens: 4096
  temperature: 0.3
data:
  # engine 落盘根目录（其下有 analysis_results/<symbol>/<date>/reports/*.md）。
  # 本机无 Docker 运行：与 engine 的 TA_DATA_DIR 指同一处（run_local.py 会用
  #   STUDIO__DATA__TA_DIR 自动覆盖为仓库下 data/，此处留默认值即可）；
  # docker-compose 部署：引擎数据卷只读挂载在 /data/ta（compose 已注入覆盖）。
  ta_dir: /data/ta
notify:
  report_url_prefix: http://localhost:8890   # 生产改成 http://<服务器IP>:8890
  channels:
    feishu:
      # 企业自建应用凭证：bot 长连接入站 + app 模式出站推送（推荐，单一身份）
      app_id: ${FEISHU_APP_ID}
      app_secret: ${FEISHU_APP_SECRET}
      # 推送目标会话；可留空——机器人收到第一条用户消息后自动学习
      chat_id: ${FEISHU_CHAT_ID}
      # chat_id 白名单，空列表=不限制；私聊/群聊的 chat_id 均可配
      allowed_chat_ids: []
      # 可选备用出站：群自定义机器人 webhook（不配则只走 app 模式）
      # webhook: https://open.feishu.cn/open-apis/bot/v2/hook/xxx
      # secret: ''
compare:
  defaults:
    depth: 标准
    analysts:
    - market
    - fundamentals
    - news
    concurrency: 2
    poll_interval: 10
  prices:
    glm-5.3:
      input: 0.0
      output: 0.0
  aliases:
    <API模型ID>: <显示名>
replay:
  theme: dark
  exports_dir: data/exports
# 飞书 bot 行为
bot:
  # 确认卡排队 ETA 的单票预估分钟数（按最近一次实测调整；kimi-k2.5+glm-5 约 16）
  est_minutes_per_stock: 16
cron:
  timezone: Asia/Shanghai
  jobs:
  - name: 07:30 兜底提醒
    type: reminder
    schedule: 30 7 * * 1-5
    # 到点检查今天是否已有运行；没有则向飞书发提醒
  # 固定标的自动分析示例（按需启用；晨报主流程是飞书发代码列表触发）：
  # - name: 早盘简报
  #   schedule: 30 9 * * 1-5
  #   symbol: 002594
  #   depth: 标准
  #   pipeline:
  #   - digest
  #   - notify
