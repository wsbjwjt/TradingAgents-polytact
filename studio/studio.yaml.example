api:
  base_url: http://localhost:8000          # polytact engine 地址
  username: ${ENGINE_USERNAME}             # engine 登录账号
  password: ${ENGINE_PASSWORD}             # engine 登录密码
  timeout: 30
llm:
  base_url: https://open.bigmodel.cn/api/paas/v4
  api_key: ${ZHIPU_API_KEY}
  model: glm-5.3
  max_tokens: 4096
  temperature: 0.3
  extra_body:
    reasoning_effort: low
data:
  # engine 落盘根目录，包含 analysis_results/<symbol>/<date>/reports/*.md
  ta_dir: /path/to/engine/analysis_results
notify:
  report_url_prefix: http://localhost:8890
  channels:
    feishu:
      # 群机器人 webhook：用于 cron / bot 分析完成后推送 digest 卡片
      webhook: ${FEISHU_WEBHOOK}
      secret: ''
      # 企业自建应用凭证：studio bot 长连接必需
      app_id: ${FEISHU_APP_ID}
      app_secret: ${FEISHU_APP_SECRET}
      # chat_id 白名单，空列表=不限制；私聊/群聊的 chat_id 均可配
      allowed_chat_ids: []
compare:
  defaults:
    depth: 标准
    analysts:
    - market
    - fundamentals
    - news
    concurrency: 2
    poll_interval: 10
  prices:
    glm-5.3:
      input: 0.0
      output: 0.0
  aliases:
    <API模型ID>: <显示名>
replay:
  theme: dark
  exports_dir: data/exports
cron:
  timezone: Asia/Shanghai
  jobs:
  - name: 早盘简报
    schedule: 30 9 * * 1-5
    symbol: 002594
    depth: 标准
    pipeline:
    - digest
    - notify
  # - name: 07:30 兜底提醒
  #   type: reminder
  #   schedule: 30 7 * * 1-5
  #   # 到点检查今天是否已有运行；没有则向飞书发提醒
