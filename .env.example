# ===== LLM（阿里百炼 Coding Plan，OpenAI 兼容）=====
BACKEND_URL=https://coding.dashscope.aliyuncs.com/v1
OPENAI_COMPATIBLE_API_KEY=填你的百炼key

# ===== engine 服务 =====
ENGINE_PORT=8000
ENGINE_USERNAME=admin
ENGINE_PASSWORD=填一个强密码
JWT_SECRET=填一段长随机串
ENGINE_DEEP_MODEL=qwen3.7-plus
ENGINE_QUICK_MODEL=qwen3.5-plus
# 引擎任务与报告数据目录
#   服务器 docker-compose：保持 /data（容器内路径，compose 挂卷）
#   本机无 Docker：留空或删掉本行即可，run_local.py 会自动用仓库下 data/
TA_DATA_DIR=/data
# mock 模式：1=不调用真实引擎，3 秒假跑（联调/测试用）
POLYTACT_ENGINE_MOCK=0

# ===== 飞书自建应用 =====
FEISHU_APP_ID=填cli_xxx
FEISHU_APP_SECRET=填app_secret
# 可选：推送目标会话 chat_id（留空=机器人收到第一条消息后自动学习）
FEISHU_CHAT_ID=
# 可选：只响应这些群/会话（逗号分隔 chat_id），留空=不限制
FEISHU_CHAT_WHITELIST=

# ===== studio =====
# 报告服务端口（UFW 已放行 8890）
STUDIO_REPORT_PORT=8890
# 报告链接对外的地址前缀（飞书卡片按钮跳转用）
REPORT_URL_PREFIX=http://101.200.180.180:8890
# 报告链接令牌密钥（必填，公网服务 fail closed）
REPORT_TOKEN_SECRET=填一段长随机串
# 东财限流间隔（秒），批量场景可调大
EM_MIN_INTERVAL=1.0
